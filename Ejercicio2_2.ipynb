       "            var desiredBottomAssoc = bottomAssoc + 166;\n",
       "\n",
       "            var finalHeight = Math.max(desiredBottomBreakdown, desiredBottomAssoc);\n",
       "            if ($(this).parent().attr(&#x27;id&#x27;) == &quot;summary-target&quot;)\n",
       "            {\n",
