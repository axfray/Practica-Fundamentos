       "\n",
       "        // Animate to the top of the screen when expanding, so we can see the whole thing immediately\n",
       "        $(&#x27;html,body&#x27;).animate(\n",
       "            {scrollTop: $(&quot;#&quot; + $(this).parent().attr(&#x27;id&#x27;)).offset().top}, &#x27;fast&#x27;);\n",
       "    }\n",
